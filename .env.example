# --- Server ---
NODE_ENV=development
PORT=4000

# --- Database ---
MONGODB_URI=mongodb://127.0.0.1:27017/auth_api

# --- JWT ---
# Generate strong secrets: `openssl rand -hex 64`
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long_xxxxxxxx
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# --- CORS / Client ---
CLIENT_URL=http://localhost:3000

# --- SMTP (nodemailer). Leave SMTP_HOST empty to log verification links to console instead of sending email ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Auth API <no-reply@example.com>"
